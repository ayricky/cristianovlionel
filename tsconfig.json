{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": false, "resolveJsonModule": true, "isolatedModules": true,
    "skipLibCheck": true, "noEmit": true, "types": ["vite/client"], "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src"]
}
